APP_ENV=local
APP_NAME=ddakkok-be
BACKEND_PORT=8000

DATABASE_URL=postgresql+psycopg://ddakkok:ddakkok@db:5432/ddakkok

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

AI_PROVIDER=mock
OCR_PROVIDER=mock

AI_CACHE_ENABLED=true
AI_CACHE_MAXSIZE=256

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GMS_API_KEY=
GMS_API_URL=
GMS_MODEL=

# Groq (무료 OpenAI 호환 API) — AI_PROVIDER=groq 로 사용
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

CLOVA_OCR_API_KEY=
CLOVA_OCR_API_URL=